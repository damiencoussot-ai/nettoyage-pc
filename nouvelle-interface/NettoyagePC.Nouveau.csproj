<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nettoyage PC 5 : nouvelle interface Avalonia (dessinée par la carte graphique), en cours de construction.
       La version 4 (WinForms, .NET Framework 4.8) reste la version publiée tant que celle-ci n'est pas prête. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NettoyagePC</AssemblyName>
    <RootNamespace>NettoyagePC.Nouveau</RootNamespace>
    <ApplicationIcon>Assets\NettoyagePC.ico</ApplicationIcon>
    <Version>5.0.0</Version>
    <InformationalVersion>5.0-apercu</InformationalVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <!-- rendu sans écran : captures automatiques de l'interface (essais et aperçus) -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.0" />
  </ItemGroup>
</Project>
