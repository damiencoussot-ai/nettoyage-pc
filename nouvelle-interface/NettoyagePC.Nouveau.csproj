<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nettoyage PC 5 : nouvelle interface Avalonia (dessinée par la carte graphique), en cours de construction.
       La version 4 (WinForms, .NET Framework 4.8) reste la version publiée tant que celle-ci n'est pas prête. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NettoyagePC</AssemblyName>
    <RootNamespace>NettoyagePC.Nouveau</RootNamespace>
    <ApplicationIcon>Assets\NettoyagePC.ico</ApplicationIcon>
    <Version>5.2.1</Version>
    <InformationalVersion>5.0-apercu</InformationalVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- programme en un seul fichier : compressé (environ moitié moins gros), ressources en français, anglais et espagnol seulement -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>fr;en;es</SatelliteResourceLanguages>
    <!-- moteur de la version 4 : API propres à Windows (CA1416), WebRequest (SYSLIB0014), champs remplis par réflexion (CS0649) -->
    <NoWarn>$(NoWarn);CS1591;CA1416;SYSLIB0014;CS0649;CS0168;CS0219;CS0414;CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- moteur partagé avec la version 4 : les mêmes fichiers (nettoyage, analyses, licence, bilan...), sans copie -->
    <Compile Include="..\src\Noyau\**\*.cs" Link="Moteur4\Noyau\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\src\Moteur\**\*.cs" Link="Moteur4\Moteur\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- textes légaux intégrés au programme (mêmes noms de ressources que la version 4) -->
    <EmbeddedResource Include="..\legal\*.txt" LogicalName="legal.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <!-- rendu sans écran : captures automatiques de l'interface (essais et aperçus) -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.0" />
    <!-- pour le moteur : WMI, services, journaux d'événements, compteurs de performance, protection des données de licence -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- dépendance d'Avalonia sous Linux : version corrigée (faille GHSA-xrw6-gwf8-vvr9, corrigée en 0.21.3) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>
